# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── watsonx.ai (Ask feature) ─────────────────────────────────────────────────
# Required to enable the natural-language Ask box on the dashboard.
# Never commit a filled-in .env to Git.
#
# WATSONX_API_KEY     — IBM Cloud API key. Create one at:
#                       https://cloud.ibm.com/iam/apikeys
# WATSONX_PROJECT_ID  — Your watsonx.ai project ID. Find it on the project's
#                       Manage → General page in watsonx.ai.
# WATSONX_URL         — Regional endpoint. Defaults to US South:
#                       https://us-south.ml.cloud.ibm.com
#                       EU Frankfurt: https://eu-de.ml.cloud.ibm.com
#                       Japan:        https://jp-tok.ml.cloud.ibm.com
# WATSONX_MODEL_ID    — Model to use. Defaults to ibm/granite-3-3-8b-instruct
#
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# ─── Dataset API Keys ─────────────────────────────────────────────────────────
# Add a variable for each federal API your tools call, and a matching typed
# field in src/example_server/config.py. Never commit the filled-in .env.
#
# EXAMPLE_API_KEY=your_key_here
